# PostgreSQL Supabase Database Connection
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_SUPABASE_ID].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_SUPABASE_ID].supabase.co:5432/postgres"

# Supabase Client API Config
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_SUPABASE_ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# AI Key Configuration (Protected on server side)
GEMINI_API_KEY="your_gemini_api_key_here"

# TikTok OAuth Integration
TIKTOK_CLIENT_KEY="your_tiktok_client_key_here"
TIKTOK_CLIENT_SECRET="your_tiktok_client_secret_here"
TIKTOK_REDIRECT_URI="http://localhost:3000/api/v1/auth/tiktok/callback"

# Server Port
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
