        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .landing-a, .landing-a p, .landing-a a, .landing-a span, .landing-a button, .landing-a label, .landing-a input, .landing-a textarea, .landing-a select { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .landing-a h1, .landing-a h2, .landing-a h3 { font-family: 'Outfit', sans-serif; }\n</style>\n<div class=\"landing-a min-h-screen bg-[#F7F8FC] text-[#0F172A] font-['Plus_Jakarta_Sans'] selection:bg-[#DDE9FF] selection:text-[#0F172A]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"sticky top-0 z-40 border-b border-slate-200/80 bg-[#F7F8FC]/95 backdrop-blur-md\" data-kid=\"1-1\" data-name=\"sticky site header\">\n        <div class=\"mx-auto grid max-w-7xl grid-cols-[1fr_auto_1fr] items-center gap-6 px-6 py-4 lg:px-10\" data-kid=\"1-1-1\" data-name=\"navigation grid container\">\n            <a class=\"justify-self-start text-[30px] font-['Outfit'] font-extrabold italic leading-none tracking-[-0.08em] text-[#0F172A]\" data-kid=\"1-1-1-1\" data-name=\"site logo link\" href=\"#top\">\n                Jeli.\n            </a>\n            <nav aria-label=\"Основная навигация\" class=\"hidden items-center gap-7 text-[13px] font-semibold text-slate-500 lg:flex\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n                <a class=\"hover:text-[#0F172A]\" data-kid=\"1-1-1-2-1\" data-name=\"how it works link\" href=\"#how-it-works\">\n                    Как работает\n                </a>\n                <a class=\"hover:text-[#0F172A]\" data-kid=\"1-1-1-2-2\" data-name=\"for business link\" href=\"#for-business\">\n                    Бизнесу\n                </a>\n                <a class=\"hover:text-[#0F172A]\" data-kid=\"1-1-1-2-3\" data-name=\"for influencers link\" href=\"#for-influencers\">\n                    Инфлюенсерам\n                </a>\n                <a class=\"hover:text-[#0F172A]\" data-kid=\"1-1-1-2-4\" data-name=\"catalog link\" href=\"#catalog\">\n                    Каталог\n                </a>\n                <a class=\"hover:text-[#0F172A]\" data-kid=\"1-1-1-2-5\" data-name=\"explore link\" href=\"#explore\">\n                    Explore\n                </a>\n                <a class=\"hover:text-[#0F172A]\" data-kid=\"1-1-1-2-6\" data-name=\"dashboard link\" href=\"#dashboard\">\n                    Дашборд\n                </a>\n            </nav>\n            <div class=\"flex items-center justify-self-end gap-3\" data-kid=\"1-1-1-3\" data-name=\"header actions container\">\n                <button aria-label=\"Переключить тему\" class=\"grid h-10 w-10 place-items-center rounded-xl border border-slate-200 bg-white text-slate-600 hover:border-slate-300 hover:text-[#0F172A]\" data-kid=\"1-1-1-3-1\" data-name=\"theme toggle button\" title=\"Переключить тему\" type=\"button\">\n                    <span class=\"text-[18px]\" data-kid=\"1-1-1-3-1-1\" data-name=\"sun icon container\" style=\"color:#475569;font-size:18px;line-height:1\">\n                        <i class=\"ti ti-sun\" data-kid=\"1-1-1-3-1-1-1\" data-name=\"sun icon\">\n                        </i>\n                    </span>\n                </button>\n                <a class=\"rounded-xl bg-[#0064FF] px-5 py-2.5 text-[13px] font-bold text-white hover:bg-[#0052D4]\" data-kid=\"1-1-1-3-2\" data-name=\"login button\" href=\"#login\">\n                    Войти\n                </a>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\" id=\"top\">\n        <section class=\"mx-auto grid max-w-7xl grid-cols-1 items-center gap-14 px-6 pb-16 pt-14 md:pt-20 lg:grid-cols-12 lg:gap-12 lg:px-10 lg:pb-24 lg:pt-24\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"lg:col-span-5\" data-kid=\"1-2-1-1\" data-name=\"hero text content column\">\n                <p class=\"mb-6 text-[12px] font-bold uppercase tracking-[0.16em] text-[#0064FF]\" data-kid=\"1-2-1-1-1\" data-name=\"hero tag\">\n                    AI-платформа инфлюенс-маркетинга в Казахстане\n                </p>\n                <h1 class=\"max-w-xl text-[48px] font-['Outfit'] font-700 leading-[0.98] tracking-[-0.055em] text-[#0F172A] md:text-[66px]\" data-kid=\"1-2-1-1-2\" data-name=\"hero headline\">\n                    Реклама через инфлюенсеров — без хаоса и посредников\n                </h1>\n                <p class=\"mt-7 max-w-lg text-[17px] leading-8 text-slate-600\" data-kid=\"1-2-1-1-3\" data-name=\"hero description\">\n                    Jeli связывает бизнес с реальными зарегистрированными инфлюенсерами. Опишите задачу, получите точный AI-подбор и проведите сделку с защитой Escrow.\n                </p>\n                <div class=\"mt-8 space-y-4 text-[14px] font-semibold text-slate-700\" data-kid=\"1-2-1-1-4\" data-name=\"features list container\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1-4-1\" data-name=\"feature item one\">\n                        <span class=\"text-[18px]\" data-kid=\"1-2-1-1-4-1-1\" data-name=\"check icon container\" style=\"color:#0064FF;font-size:18px;line-height:1\">\n                            <i class=\"ti ti-check\" data-kid=\"1-2-1-1-4-1-1-1\" data-name=\"check icon\">\n                            </i>\n                        </span>\n                        <span data-kid=\"1-2-1-1-4-1-2\" data-name=\"feature one text\">\n                            Прямой AI-мэтчинг по вашей задаче\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1-4-2\" data-name=\"feature item two\">\n                        <span class=\"text-[18px]\" data-kid=\"1-2-1-1-4-2-1\" data-name=\"shield icon container\" style=\"color:#0064FF;font-size:18px;line-height:1\">\n                            <i class=\"ti ti-shield-check\" data-kid=\"1-2-1-1-4-2-1-1\" data-name=\"shield check icon\">\n                            </i>\n                        </span>\n                        <span data-kid=\"1-2-1-1-4-2-2\" data-name=\"feature two text\">\n                            Защита сделки через Escrow\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1-4-3\" data-name=\"feature item three\">\n                        <span class=\"text-[18px]\" data-kid=\"1-2-1-1-4-3-1\" data-name=\"receipt icon container\" style=\"color:#0064FF;font-size:18px;line-height:1\">\n                            <i class=\"ti ti-receipt-off\" data-kid=\"1-2-1-1-4-3-1-1\" data-name=\"receipt off icon\">\n                            </i>\n                        </span>\n                        <span data-kid=\"1-2-1-1-4-3-2\" data-name=\"feature three text\">\n                            Без комиссий посредников\n                        </span>\n                    </div>\n                </div>\n                <div class=\"mt-10 flex flex-wrap items-center gap-4\" data-kid=\"1-2-1-1-5\" data-name=\"hero cta buttons container\">\n                    <a class=\"rounded-xl bg-[#0064FF] px-6 py-3.5 text-[14px] font-bold text-white shadow-sm shadow-blue-600/20 hover:bg-[#0052D4]\" data-kid=\"1-2-1-1-5-1\" data-name=\"start campaign cta button\" href=\"#matcher\">\n                        Запустить кампанию\n                    </a>\n                    <a class=\"inline-flex items-center gap-2 px-1 py-3.5 text-[14px] font-bold text-[#0F172A] hover:text-[#0064FF]\" data-kid=\"1-2-1-1-5-2\" data-name=\"watch how it works button\" href=\"#how-it-works\">\n                        Смотреть, как работает\n                        <span class=\"text-[16px]\" data-kid=\"1-2-1-1-5-2-1\" data-name=\"arrow icon container\" style=\"color:#0064FF;font-size:16px;line-height:1\">\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-1-1-5-2-1-1\" data-name=\"arrow up right icon\">\n                            </i>\n                        </span>\n                    </a>\n                </div>\n                <div class=\"mt-12 flex items-center gap-3 text-[12px] text-slate-500\" data-kid=\"1-2-1-1-6\" data-name=\"hero safety notice container\">\n                    <span class=\"text-[17px]\" data-kid=\"1-2-1-1-6-1\" data-name=\"lock icon container\" style=\"color:#0064FF;font-size:17px;line-height:1\">\n                        <i class=\"ti ti-lock\" data-kid=\"1-2-1-1-6-1-1\" data-name=\"lock icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-2-1-1-6-2\" data-name=\"hero safety notice text\">\n                        Безопасная платформа для бизнеса и авторов\n                    </span>\n                </div>\n            </div>\n            <div class=\"lg:col-span-7 lg:pl-8\" data-kid=\"1-2-1-2\" data-name=\"campaign matcher column\" id=\"matcher\">\n                <div class=\"border border-slate-200 bg-white p-5 shadow-[0_22px_60px_-32px_rgba(15,23,42,0.38)] md:p-7\" data-kid=\"1-2-1-2-1\" data-name=\"campaign form card\" style=\"border-radius:20px\">\n                    <div class=\"flex items-start justify-between gap-5 border-b border-slate-200 pb-5\" data-kid=\"1-2-1-2-1-1\" data-name=\"card header\">\n                        <div data-kid=\"1-2-1-2-1-1-1\" data-name=\"card title container\">\n                            <p class=\"mb-2 text-[11px] font-bold uppercase tracking-[0.14em] text-slate-400\" data-kid=\"1-2-1-2-1-1-1-1\" data-name=\"step indicator\">\n                                Кампания · шаг 1 из 3\n                            </p>\n                            <h2 class=\"font-['Outfit'] text-[30px] font-700 tracking-[-0.04em] text-[#0F172A]\" data-kid=\"1-2-1-2-1-1-1-2\" data-name=\"card headline\">\n                                Найдите подходящих инфлюенсеров\n                            </h2>\n                        </div>\n                        <span class=\"grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[#EEF4FF] text-[21px]\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"adjustments icon container\" style=\"color:#0064FF;font-size:21px;line-height:1\">\n                            <i class=\"ti ti-adjustments-horizontal\" data-kid=\"1-2-1-2-1-1-2-1\" data-name=\"adjustments horizontal icon\">\n                            </i>\n                        </span>\n                    </div>\n                    <div class=\"mt-5 flex items-center justify-between border-b border-slate-100 pb-5 text-[12px] font-semibold\" data-kid=\"1-2-1-2-1-2\" data-name=\"live profile counter container\">\n                        <span class=\"flex items-center gap-2 text-emerald-700\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"active status indicator\">\n                            <span class=\"h-2 w-2 rounded-full bg-emerald-500\" data-kid=\"1-2-1-2-1-2-1-1\" data-name=\"indicator dot\">\n                            </span>\n                            База зарегистрированных профилей\n                        </span>\n                        <span class=\"text-slate-400\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"profile count\">\n                            0 профилей\n                        </span>\n                    </div>\n                    <form class=\"mt-6 space-y-5\" data-kid=\"1-2-1-2-1-3\" data-name=\"campaign configuration form\">\n                        <label class=\"block\" data-kid=\"1-2-1-2-1-3-1\" data-name=\"campaign description input group\">\n                            <span class=\"mb-2 block text-[12px] font-bold text-slate-700\" data-kid=\"1-2-1-2-1-3-1-1\" data-name=\"input label\">\n                                Что вы продвигаете?\n                            </span>\n                            <textarea class=\"w-full resize-none rounded-xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-[13px] leading-6 text-slate-700 outline-none ring-[#0064FF]/20 placeholder:text-slate-400 focus:border-[#0064FF] focus:ring-4\" data-kid=\"1-2-1-2-1-3-1-2\" data-name=\"campaign description textarea\" placeholder=\"Опишите продукт, аудиторию и задачу кампании...\" rows=\"4\">Ищем IT, бизнес и технологических блогеров в Казахстане для продвижения AI-платформы Jeli.</textarea>\n                        </label>\n                        <div class=\"grid grid-cols-1 gap-4 md:grid-cols-2\" data-kid=\"1-2-1-2-1-3-2\" data-name=\"form options grid\">\n                            <label class=\"block\" data-kid=\"1-2-1-2-1-3-2-1\" data-name=\"niche selection input group\">\n                                <span class=\"mb-2 block text-[12px] font-bold text-slate-700\" data-kid=\"1-2-1-2-1-3-2-1-1\" data-name=\"niche label\">\n                                    Целевая ниша\n                                </span>\n                                <span class=\"relative block\" data-kid=\"1-2-1-2-1-3-2-1-2\" data-name=\"niche select wrapper\">\n                                    <select class=\"w-full appearance-none rounded-xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-[13px] text-slate-700 outline-none focus:border-[#0064FF] focus:ring-4 focus:ring-[#0064FF]/20\" data-kid=\"1-2-1-2-1-3-2-1-2-1\" data-name=\"niche select dropdown\">\n                                        <option data-kid=\"1-2-1-2-1-3-2-1-2-1-1\" data-name=\"niche option 1\">\n                                            Все ниши\n                                        </option>\n                                        <option data-kid=\"1-2-1-2-1-3-2-1-2-1-2\" data-name=\"niche option 2\">\n                                            IT & Технологии\n                                        </option>\n                                        <option data-kid=\"1-2-1-2-1-3-2-1-2-1-3\" data-name=\"niche option 3\">\n                                            Бизнес & Финансы\n                                        </option>\n                                        <option data-kid=\"1-2-1-2-1-3-2-1-2-1-4\" data-name=\"niche option 4\">\n                                            Развлечения & Шоу\n                                        </option>\n                                        <option data-kid=\"1-2-1-2-1-3-2-1-2-1-5\" data-name=\"niche option 5\">\n                                            Фитнес & Спорт\n                                        </option>\n                                    </select>\n                                    <span class=\"pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-[16px]\" data-kid=\"1-2-1-2-1-3-2-1-2-2\" data-name=\"chevron icon container\" style=\"color:#64748B;font-size:16px;line-height:1\">\n                                        <i class=\"ti ti-chevron-down\" data-kid=\"1-2-1-2-1-3-2-1-2-2-1\" data-name=\"chevron down icon\">\n                                        </i>\n                                    </span>\n                                </span>\n                            </label>\n                            <label class=\"block\" data-kid=\"1-2-1-2-1-3-2-2\" data-name=\"budget input group\">\n                                <span class=\"mb-2 block text-[12px] font-bold text-slate-700\" data-kid=\"1-2-1-2-1-3-2-2-1\" data-name=\"budget label\">\n                                    Планируемый бюджет\n                                </span>\n                                <span class=\"relative block\" data-kid=\"1-2-1-2-1-3-2-2-2\" data-name=\"budget input wrapper\">\n                                    <input class=\"w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-[13px] text-slate-700 outline-none focus:border-[#0064FF] focus:ring-4 focus:ring-[#0064FF]/20\" data-kid=\"1-2-1-2-1-3-2-2-2-1\" data-name=\"budget input field\" value=\"500,000 ₸\"/>\n                                    <span class=\"pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-[15px]\" data-kid=\"1-2-1-2-1-3-2-2-2-2\" data-name=\"wallet icon container\" style=\"color:#64748B;font-size:15px;line-height:1\">\n                                        <i class=\"ti ti-wallet\" data-kid=\"1-2-1-2-1-3-2-2-2-2-1\" data-name=\"wallet icon\">\n                                        </i>\n                                    </span>\n                                </span>\n                            </label>\n                        </div>\n                        <button class=\"flex w-full items-center justify-center gap-2 rounded-xl bg-[#0064FF] px-5 py-4 text-[14px] font-bold text-white hover:bg-[#0052D4]\" data-kid=\"1-2-1-2-1-3-3\" data-name=\"submit button\" type=\"button\">\n                            <span class=\"text-[17px]\" data-kid=\"1-2-1-2-1-3-3-1\" data-name=\"sparkles icon container\" style=\"color:#FFFFFF;font-size:17px;line-height:1\">\n                                <i class=\"ti ti-sparkles\" data-kid=\"1-2-1-2-1-3-3-1-1\" data-name=\"sparkles icon\">\n                                </i>\n                            </span>\n                            Провести AI-поиск по базе\n                        </button>\n                    </form>\n                    <div class=\"mt-5 flex items-start gap-3 border-t border-slate-100 pt-5 text-[11px] leading-5 text-slate-500\" data-kid=\"1-2-1-2-1-4\" data-name=\"escrow info container\">\n                        <span class=\"text-[16px]\" data-kid=\"1-2-1-2-1-4-1\" data-name=\"shield lock icon container\" style=\"color:#0064FF;font-size:16px;line-height:1\">\n                            <i class=\"ti ti-shield-lock\" data-kid=\"1-2-1-2-1-4-1-1\" data-name=\"shield lock icon\">\n                            </i>\n                        </span>\n                        <p data-kid=\"1-2-1-2-1-4-2\" data-name=\"escrow info text\">\n                            Escrow удерживает оплату до подтверждения результата. Вы платите напрямую автору — без комиссий посредников.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-y border-slate-200 bg-white\" data-kid=\"1-2-2\" data-name=\"trust signals section\">\n            <div class=\"mx-auto grid max-w-7xl grid-cols-2 divide-x divide-slate-200 md:grid-cols-4 lg:px-10\" data-kid=\"1-2-2-1\" data-name=\"signals grid\">\n                <div class=\"flex items-center gap-3 px-6 py-5 lg:px-0 lg:pl-0\" data-kid=\"1-2-2-1-1\" data-name=\"signal item 1\">\n                    <span class=\"text-[21px]\" data-kid=\"1-2-2-1-1-1\" data-name=\"signal 1 icon container\" style=\"color:#0064FF;font-size:21px;line-height:1\">\n                        <i class=\"ti ti-shield-check\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"shield check icon\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-2-2-1-1-2\" data-name=\"signal 1 text content\">\n                        <p class=\"text-[13px] font-bold text-[#0F172A]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"signal 1 title\">\n                            Escrow-защита\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] text-slate-500\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"signal 1 subtitle\">\n                            Оплата после результата\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-3 px-6 py-5 lg:pl-8\" data-kid=\"1-2-2-1-2\" data-name=\"signal item 2\">\n                    <span class=\"text-[21px]\" data-kid=\"1-2-2-1-2-1\" data-name=\"signal 2 icon container\" style=\"color:#0064FF;font-size:21px;line-height:1\">\n                        <i class=\"ti ti-sparkles\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"sparkles icon\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-2-2-1-2-2\" data-name=\"signal 2 text content\">\n                        <p class=\"text-[13px] font-bold text-[#0F172A]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"signal 2 title\">\n                            AI-мэтчинг\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] text-slate-500\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"signal 2 subtitle\">\n                            Подбор под задачу\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-3 px-6 py-5 lg:pl-8\" data-kid=\"1-2-2-1-3\" data-name=\"signal item 3\">\n                    <span class=\"text-[21px]\" data-kid=\"1-2-2-1-3-1\" data-name=\"signal 3 icon container\" style=\"color:#0064FF;font-size:21px;line-height:1\">\n                        <i class=\"ti ti-user-check\" data-kid=\"1-2-2-1-3-1-1\" data-name=\"user check icon\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-2-2-1-3-2\" data-name=\"signal 3 text content\">\n                        <p class=\"text-[13px] font-bold text-[#0F172A]\" data-kid=\"1-2-2-1-3-2-1\" data-name=\"signal 3 title\">\n                            Верифицированные профили\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] text-slate-500\" data-kid=\"1-2-2-1-3-2-2\" data-name=\"signal 3 subtitle\">\n                            Только реальные авторы\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-3 px-6 py-5 lg:pl-8\" data-kid=\"1-2-2-1-4\" data-name=\"signal item 4\">\n                    <span class=\"text-[21px]\" data-kid=\"1-2-2-1-4-1\" data-name=\"signal 4 icon container\" style=\"color:#0064FF;font-size:21px;line-height:1\">\n                        <i class=\"ti ti-percentage-0\" data-kid=\"1-2-2-1-4-1-1\" data-name=\"percentage icon\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-2-2-1-4-2\" data-name=\"signal 4 text content\">\n                        <p class=\"text-[13px] font-bold text-[#0F172A]\" data-kid=\"1-2-2-1-4-2-1\" data-name=\"signal 4 title\">\n                            0% комиссии\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] text-slate-500\" data-kid=\"1-2-2-1-4-2-2\" data-name=\"signal 4 subtitle\">\n                            Прямые сделки\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-28\" data-kid=\"1-2-3\" data-name=\"how it works section\" id=\"how-it-works\">\n            <div class=\"grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16\" data-kid=\"1-2-3-1\" data-name=\"how it works grid\">\n                <div class=\"lg:col-span-4\" data-kid=\"1-2-3-1-1\" data-name=\"how it works intro\">\n                    <p class=\"mb-4 text-[11px] font-bold uppercase tracking-[0.16em] text-[#0064FF]\" data-kid=\"1-2-3-1-1-1\" data-name=\"how it works tag\">\n                        Как это работает\n                    </p>\n                    <h2 class=\"max-w-sm font-['Outfit'] text-[39px] font-700 leading-[1.02] tracking-[-0.05em] text-[#0F172A]\" data-kid=\"1-2-3-1-1-2\" data-name=\"how it works headline\">\n                        От задачи до кампании — в одном потоке\n                    </h2>\n                    <p class=\"mt-5 max-w-sm text-[14px] leading-7 text-slate-500\" data-kid=\"1-2-3-1-1-3\" data-name=\"how it works description\">\n                        Без долгих переписок и непрозрачных посредников. Jeli помогает пройти путь от идеи до защищённой сделки.\n                    </p>\n                </div>\n                <div class=\"lg:col-span-8\" data-kid=\"1-2-3-1-2\" data-name=\"steps grid\">\n                    <div class=\"grid grid-cols-1 border-t border-slate-300 md:grid-cols-3\" data-kid=\"1-2-3-1-2-1\" data-name=\"steps container\">\n                        <div class=\"relative border-b border-slate-200 py-7 md:border-b-0 md:border-r md:pr-7\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"step 1 card\">\n                            <span class=\"mb-6 grid h-9 w-9 place-items-center rounded-lg bg-[#0F172A] text-[12px] font-bold text-white\" data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"step 1 number\">\n                                01\n                            </span>\n                            <h3 class=\"font-['Outfit'] text-[22px] font-600 tracking-[-0.03em]\" data-kid=\"1-2-3-1-2-1-1-2\" data-name=\"step 1 title\">\n                                Опишите задачу\n                            </h3>\n                            <p class=\"mt-3 text-[13px] leading-6 text-slate-500\" data-kid=\"1-2-3-1-2-1-1-3\" data-name=\"step 1 description\">\n                                Расскажите про продукт, аудиторию, нишу и бюджет — AI поймёт контекст кампании.\n                            </p>\n                        </div>\n                        <div class=\"relative border-b border-slate-200 py-7 md:border-b-0 md:border-r md:px-7\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"step 2 card\">\n                            <span class=\"mb-6 grid h-9 w-9 place-items-center rounded-lg bg-[#DDE9FF] text-[12px] font-bold text-[#0064FF]\" data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"step 2 number\">\n                                02\n                            </span>\n                            <h3 class=\"font-['Outfit'] text-[22px] font-600 tracking-[-0.03em]\" data-kid=\"1-2-3-1-2-1-2-2\" data-name=\"step 2 title\">\n                                Выберите профиль\n                            </h3>\n                            <p class=\"mt-3 text-[13px] leading-6 text-slate-500\" data-kid=\"1-2-3-1-2-1-2-3\" data-name=\"step 2 description\">\n                                Сравните реальные профили по нише, городу и ключевым метрикам вовлечённой аудитории.\n                            </p>\n                        </div>\n                        <div class=\"py-7 md:pl-7\" data-kid=\"1-2-3-1-2-1-3\" data-name=\"step 3 card\">\n                            <span class=\"mb-6 grid h-9 w-9 place-items-center rounded-lg bg-[#DDE9FF] text-[12px] font-bold text-[#0064FF]\" data-kid=\"1-2-3-1-2-1-3-1\" data-name=\"step 3 number\">\n                                03\n                            </span>\n                            <h3 class=\"font-['Outfit'] text-[22px] font-600 tracking-[-0.03em]\" data-kid=\"1-2-3-1-2-1-3-2\" data-name=\"step 3 title\">\n                                Запустите кампанию\n                            </h3>\n                            <p class=\"mt-3 text-[13px] leading-6 text-slate-500\" data-kid=\"1-2-3-1-2-1-3-3\" data-name=\"step 3 description\">\n                                Зафиксируйте условия, внесите оплату в Escrow и получите контент с прозрачным результатом.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-auto grid max-w-7xl grid-cols-1 gap-5 px-6 pb-20 lg:grid-cols-12 lg:px-10 lg:pb-28\" data-kid=\"1-2-4\" data-name=\"for user segments section\">\n            <div class=\"relative min-h-[370px] overflow-hidden border border-[#C9DBFF] bg-[#EAF2FF] p-8 lg:col-span-7 lg:p-10\" data-kid=\"1-2-4-1\" data-name=\"for business card\" id=\"for-business\" style=\"border-radius:20px\">\n                <div class=\"relative z-10 max-w-sm\" data-kid=\"1-2-4-1-1\" data-name=\"for business content\">\n                    <p class=\"mb-4 text-[11px] font-bold uppercase tracking-[0.16em] text-[#0064FF]\" data-kid=\"1-2-4-1-1-1\" data-name=\"business tag\">\n                        Для бизнеса\n                    </p>\n                    <h2 class=\"font-['Outfit'] text-[37px] font-700 leading-[1.02] tracking-[-0.05em] text-[#0F172A]\" data-kid=\"1-2-4-1-1-2\" data-name=\"business headline\">\n                        Ваш следующий автор уже в базе\n                    </h2>\n                    <p class=\"mt-4 text-[14px] leading-6 text-slate-600\" data-kid=\"1-2-4-1-1-3\" data-name=\"business description\">\n                        Найдите релевантного инфлюенсера без агентской наценки и начните с понятного брифа.\n                    </p>\n                    <a class=\"mt-7 inline-flex items-center gap-2 rounded-xl bg-[#0064FF] px-5 py-3 text-[13px] font-bold text-white hover:bg-[#0052D4]\" data-kid=\"1-2-4-1-1-4\" data-name=\"business cta\" href=\"#matcher\">\n                        Запустить кампанию\n                        <span class=\"text-[15px]\" data-kid=\"1-2-4-1-1-4-1\" data-name=\"arrow icon container\" style=\"color:#FFFFFF;font-size:15px;line-height:1\">\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-4-1-1-4-1-1\" data-name=\"arrow up right icon\">\n                            </i>\n                        </span>\n                    </a>\n                </div>\n                <div class=\"absolute bottom-0 right-0 h-44 w-72 overflow-hidden border-l border-t border-[#C9DBFF] bg-white/60 md:h-56 md:w-[360px]\" data-kid=\"1-2-4-1-2\" data-name=\"business card image container\" style=\"border-top-left-radius:20px\">\n                    <img alt=\"Business owner reviewing campaign data on a tablet, photo by Tyler Franta on Unsplash\" class=\"h-full w-full object-cover mix-blend-multiply opacity-90\" data-kid=\"1-2-4-1-2-1\" data-name=\"business image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1521633286323-05b17f47cb74?auto=format&w=900&q=80&fit=crop\"/>\n                </div>\n            </div>\n            <div class=\"relative min-h-[370px] overflow-hidden border border-[#17284A] bg-[#0F1C35] p-8 text-white lg:col-span-5 lg:p-10\" data-kid=\"1-2-4-2\" data-name=\"for influencers card\" id=\"for-influencers\" style=\"border-radius:20px\">\n                <div class=\"relative z-10 max-w-xs\" data-kid=\"1-2-4-2-1\" data-name=\"for influencers content\">\n                    <p class=\"mb-4 text-[11px] font-bold uppercase tracking-[0.16em] text-[#9DBDFF]\" data-kid=\"1-2-4-2-1-1\" data-name=\"influencer tag\">\n                        Для инфлюенсеров\n                    </p>\n                    <h2 class=\"font-['Outfit'] text-[37px] font-700 leading-[1.02] tracking-[-0.05em]\" data-kid=\"1-2-4-2-1-2\" data-name=\"influencer headline\">\n                        Монетизируйте контент напрямую\n                    </h2>\n                    <p class=\"mt-4 text-[14px] leading-6 text-slate-300\" data-kid=\"1-2-4-2-1-3\" data-name=\"influencer description\">\n                        Создайте профиль, покажите сильные стороны и получайте кампании от бизнеса.\n                    </p>\n                    <a class=\"mt-7 inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-[13px] font-bold text-[#0F1C35] hover:bg-[#EAF2FF]\" data-kid=\"1-2-4-2-1-4\" data-name=\"influencer cta\" href=\"#register\">\n                        Зарабатывать на контенте\n                        <span class=\"text-[15px]\" data-kid=\"1-2-4-2-1-4-1\" data-name=\"arrow icon container\" style=\"color:#0064FF;font-size:15px;line-height:1\">\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-4-2-1-4-1-1\" data-name=\"arrow up right icon\">\n                            </i>\n                        </span>\n                    </a>\n                </div>\n                <div class=\"absolute bottom-0 right-0 h-44 w-64 overflow-hidden border-l border-t border-[#2A416D] bg-[#17284A] md:h-56 md:w-72\" data-kid=\"1-2-4-2-2\" data-name=\"influencer image container\" style=\"border-top-left-radius:20px\">\n                    <img alt=\"Creator recording a video with a ring light, photo by Waddas Magalhães on Unsplash\" class=\"h-full w-full object-cover opacity-80\" data-kid=\"1-2-4-2-2-1\" data-name=\"influencer image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1617349035560-b32339aeeb14?auto=format&w=900&q=80&fit=crop\"/>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-t border-slate-200 bg-white\" data-kid=\"1-2-5\" data-name=\"catalog section\" id=\"catalog\">\n            <div class=\"mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-24\" data-kid=\"1-2-5-1\" data-name=\"catalog inner container\">\n                <div class=\"flex flex-col justify-between gap-7 border-b border-slate-200 pb-8 md:flex-row md:items-end\" data-kid=\"1-2-5-1-1\" data-name=\"catalog header\">\n                    <div data-kid=\"1-2-5-1-1-1\" data-name=\"catalog title group\">\n                        <p class=\"mb-4 text-[11px] font-bold uppercase tracking-[0.16em] text-[#0064FF]\" data-kid=\"1-2-5-1-1-1-1\" data-name=\"catalog tag\">\n                            Каталог\n                        </p>\n                        <h2 class=\"font-['Outfit'] text-[42px] font-700 tracking-[-0.05em] text-[#0F172A]\" data-kid=\"1-2-5-1-1-1-2\" data-name=\"catalog headline\">\n                            Реальные профили. Понятные метрики.\n                        </h2>\n                        <p class=\"mt-3 max-w-xl text-[14px] leading-6 text-slate-500\" data-kid=\"1-2-5-1-1-1-3\" data-name=\"catalog description\">\n                            Фильтруйте базу по городу и нише — и выбирайте автора для следующей кампании.\n                        </p>\n                    </div>\n                    <div class=\"flex flex-wrap gap-3\" data-kid=\"1-2-5-1-1-2\" data-name=\"catalog filter buttons\">\n                        <button class=\"inline-flex items-center gap-4 rounded-xl border border-slate-300 bg-white px-4 py-3 text-[13px] font-semibold text-slate-700\" data-kid=\"1-2-5-1-1-2-1\" data-name=\"city filter\" type=\"button\">\n                            Все города\n                            <span class=\"text-[15px]\" data-kid=\"1-2-5-1-1-2-1-1\" data-name=\"chevron icon container\" style=\"color:#64748B;font-size:15px;line-height:1\">\n                                <i class=\"ti ti-chevron-down\" data-kid=\"1-2-5-1-1-2-1-1-1\" data-name=\"chevron icon\">\n                                </i>\n                            </span>\n                        </button>\n                        <button class=\"inline-flex items-center gap-4 rounded-xl border border-slate-300 bg-white px-4 py-3 text-[13px] font-semibold text-slate-700\" data-kid=\"1-2-5-1-1-2-2\" data-name=\"niche filter\" type=\"button\">\n                            Все ниши\n                            <span class=\"text-[15px]\" data-kid=\"1-2-5-1-1-2-2-1\" data-name=\"chevron icon container\" style=\"color:#64748B;font-size:15px;line-height:1\">\n                                <i class=\"ti ti-chevron-down\" data-kid=\"1-2-5-1-1-2-2-1-1\" data-name=\"chevron icon\">\n                                </i>\n                            </span>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"mt-8 overflow-x-auto\" data-kid=\"1-2-5-1-2\" data-name=\"catalog table scroll wrapper\">\n                    <table class=\"w-full min-w-[920px] border-collapse text-left\" data-kid=\"1-2-5-1-2-1\" data-name=\"catalog table\">\n                        <thead data-kid=\"1-2-5-1-2-1-1\" data-name=\"table header\">\n                            <tr class=\"border-b border-slate-200 text-[10px] font-bold uppercase tracking-[0.13em] text-slate-400\" data-kid=\"1-2-5-1-2-1-1-1\" data-name=\"header row\">\n                                <th class=\"pb-4 pr-5\" data-kid=\"1-2-5-1-2-1-1-1-1\" data-name=\"header col 1\">\n                                    Профиль\n                                </th>\n                                <th class=\"pb-4 pr-5\" data-kid=\"1-2-5-1-2-1-1-1-2\" data-name=\"header col 2\">\n                                    Ниша\n                                </th>\n                                <th class=\"pb-4 pr-5\" data-kid=\"1-2-5-1-2-1-1-1-3\" data-name=\"header col 3\">\n                                    Город\n                                </th>\n                                <th class=\"pb-4 pr-5 text-right\" data-kid=\"1-2-5-1-2-1-1-1-4\" data-name=\"header col 4\">\n                                    Подписчики\n                                </th>\n                                <th class=\"pb-4 pr-5 text-right\" data-kid=\"1-2-5-1-2-1-1-1-5\" data-name=\"header col 5\">\n                                    Лайки\n                                </th>\n                                <th class=\"pb-4 pr-5 text-right\" data-kid=\"1-2-5-1-2-1-1-1-6\" data-name=\"header col 6\">\n                                    Видео\n                                </th>\n                                <th class=\"pb-4 text-right\" data-kid=\"1-2-5-1-2-1-1-1-7\" data-name=\"header col 7\">\n                                    Действие\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody data-kid=\"1-2-5-1-2-1-2\" data-name=\"table body\">\n                            <tr class=\"border-b border-dashed border-slate-300\" data-kid=\"1-2-5-1-2-1-2-1\" data-name=\"empty table row\">\n                                <td class=\"py-5 pr-5\" data-kid=\"1-2-5-1-2-1-2-1-1\" data-name=\"profile cell\">\n                                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-5-1-2-1-2-1-1-1\" data-name=\"profile info container\">\n                                        <span class=\"grid h-10 w-10 place-items-center rounded-xl bg-[#EAF2FF] text-[19px]\" data-kid=\"1-2-5-1-2-1-2-1-1-1-1\" data-name=\"user icon container\" style=\"color:#0064FF;font-size:19px;line-height:1\">\n                                            <i class=\"ti ti-user-plus\" data-kid=\"1-2-5-1-2-1-2-1-1-1-1-1\" data-name=\"user plus icon\">\n                                            </i>\n                                        </span>\n                                        <div data-kid=\"1-2-5-1-2-1-2-1-1-1-2\" data-name=\"profile details text\">\n                                            <p class=\"text-[13px] font-bold text-[#0F172A]\" data-kid=\"1-2-5-1-2-1-2-1-1-1-2-1\" data-name=\"profile name text\">\n                                                Ожидаем первый профиль\n                                            </p>\n                                            <p class=\"mt-0.5 text-[11px] text-slate-400\" data-kid=\"1-2-5-1-2-1-2-1-1-1-2-2\" data-name=\"profile subtitle text\">\n                                                Зарегистрированный инфлюенсер\n                                            </p>\n                                        </div>\n                                    </div>\n                                </td>\n                                <td class=\"py-5 pr-5 text-[12px] text-slate-400\" data-kid=\"1-2-5-1-2-1-2-1-2\" data-name=\"niche cell\">\n                                    —\n                                </td>\n                                <td class=\"py-5 pr-5 text-[12px] text-slate-400\" data-kid=\"1-2-5-1-2-1-2-1-3\" data-name=\"city cell\">\n                                    —\n                                </td>\n                                <td class=\"py-5 pr-5 text-right text-[12px] text-slate-400\" data-kid=\"1-2-5-1-2-1-2-1-4\" data-name=\"followers cell\">\n                                    —\n                                </td>\n                                <td class=\"py-5 pr-5 text-right text-[12px] text-slate-400\" data-kid=\"1-2-5-1-2-1-2-1-5\" data-name=\"likes cell\">\n                                    —\n                                </td>\n                                <td class=\"py-5 pr-5 text-right text-[12px] text-slate-400\" data-kid=\"1-2-5-1-2-1-2-1-6\" data-name=\"video cell\">\n                                    —\n                                </td>\n                                <td class=\"py-5 text-right\" data-kid=\"1-2-5-1-2-1-2-1-7\" data-name=\"action cell\">\n                                    <a class=\"inline-flex items-center gap-2 rounded-lg border border-[#B8D0FF] px-3.5 py-2 text-[12px] font-bold text-[#0064FF]\" data-kid=\"1-2-5-1-2-1-2-1-7-1\" data-name=\"register cta\" href=\"#register\">\n                                        Зарегистрировать\n                                        <span class=\"text-[14px]\" data-kid=\"1-2-5-1-2-1-2-1-7-1-1\" data-name=\"arrow icon container\" style=\"color:#0064FF;font-size:14px;line-height:1\">\n                                            <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-5-1-2-1-2-1-7-1-1-1\" data-name=\"arrow icon\">\n                                            </i>\n                                        </span>\n                                    </a>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n                <div class=\"mt-7 flex flex-col items-start justify-between gap-5 border border-dashed border-slate-300 bg-[#F7F8FC] p-5 md:flex-row md:items-center\" data-kid=\"1-2-5-1-3\" data-name=\"empty catalog notice\" style=\"border-radius:16px\">\n                    <div class=\"flex items-start gap-3\" data-kid=\"1-2-5-1-3-1\" data-name=\"empty notice icon group\">\n                        <span class=\"mt-0.5 text-[19px]\" data-kid=\"1-2-5-1-3-1-1\" data-name=\"database icon container\" style=\"color:#0064FF;font-size:19px;line-height:1\">\n                            <i class=\"ti ti-database-off\" data-kid=\"1-2-5-1-3-1-1-1\" data-name=\"database off icon\">\n                            </i>\n                        </span>\n                        <div data-kid=\"1-2-5-1-3-1-2\" data-name=\"empty notice text group\">\n                            <p class=\"text-[13px] font-bold text-[#0F172A]\" data-kid=\"1-2-5-1-3-1-2-1\" data-name=\"empty notice title\">\n                                В базе пока 0 зарегистрированных инфлюенсеров\n                            </p>\n                            <p class=\"mt-1 text-[12px] leading-5 text-slate-500\" data-kid=\"1-2-5-1-3-1-2-2\" data-name=\"empty notice description\">\n                                Профили появятся здесь сразу после регистрации и верификации автора.\n                            </p>\n                        </div>\n                    </div>\n                    <a class=\"shrink-0 text-[13px] font-bold text-[#0064FF] hover:text-[#0052D4]\" data-kid=\"1-2-5-1-3-2\" data-name=\"become author cta\" href=\"#register\">\n                        Стать первым автором\n                        <span class=\"text-[14px]\" data-kid=\"1-2-5-1-3-2-1\" data-name=\"arrow icon container\" style=\"color:#0064FF;font-size:14px;line-height:1\">\n                            <i class=\"ti ti-arrow-right\" data-kid=\"1-2-5-1-3-2-1-1\" data-name=\"arrow icon\">\n                            </i>\n                        </span>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-t border-slate-200 bg-[#F7F8FC]\" data-kid=\"1-2-6\" data-name=\"growth callout section\" id=\"explore\">\n            <div class=\"mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-6 py-12 md:flex-row md:items-center lg:px-10\" data-kid=\"1-2-6-1\" data-name=\"callout inner container\">\n                <div data-kid=\"1-2-6-1-1\" data-name=\"callout text content\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.16em] text-[#0064FF]\" data-kid=\"1-2-6-1-1-1\" data-name=\"callout tag\">\n                        Jeli для роста\n                    </p>\n                    <h2 class=\"mt-2 font-['Outfit'] text-[28px] font-700 tracking-[-0.04em]\" data-kid=\"1-2-6-1-1-2\" data-name=\"callout headline\">\n                        Готовы запустить свою следующую кампанию?\n                    </h2>\n                </div>\n                <a class=\"rounded-xl bg-[#0064FF] px-5 py-3 text-[13px] font-bold text-white hover:bg-[#0052D4]\" data-kid=\"1-2-6-1-2\" data-name=\"callout start cta\" href=\"#matcher\">\n                    Начать с AI-подбора\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-slate-200 bg-white px-6 py-10 lg:px-10\" data-kid=\"1-3\" data-name=\"site footer\">\n        <div class=\"mx-auto grid max-w-7xl grid-cols-1 gap-8 md:grid-cols-[1fr_auto] md:items-end\" data-kid=\"1-3-1\" data-name=\"footer inner container\">\n            <div data-kid=\"1-3-1-1\" data-name=\"footer brand container\">\n                <a class=\"text-[27px] font-['Outfit'] font-extrabold italic tracking-[-0.08em] text-[#0F172A]\" data-kid=\"1-3-1-1-1\" data-name=\"footer logo\" href=\"#top\">\n                    Jeli.\n                </a>\n                <p class=\"mt-3 max-w-md text-[12px] leading-5 text-slate-500\" data-kid=\"1-3-1-1-2\" data-name=\"footer description\">\n                    AI-платформа инфлюенс-маркетинга в Казахстане. Прямые кампании, реальные профили и прозрачная защита сделок.\n                </p>\n                <p class=\"mt-5 text-[11px] text-slate-400\" data-kid=\"1-3-1-1-3\" data-name=\"copyright text\">\n                    © 2026 Jeli Platform\n                </p>\n            </div>\n            <div class=\"flex flex-wrap gap-x-7 gap-y-3 text-[12px] font-semibold text-slate-500 md:justify-end\" data-kid=\"1-3-1-2\" data-name=\"footer links menu\">\n                <a class=\"hover:text-[#0F172A]\" data-kid=\"1-3-1-2-1\" data-name=\"how it works link\" href=\"#how-it-works\">\n                    Как работает\n                </a>\n                <a class=\"hover:text-[#0F172A]\" data-kid=\"1-3-1-2-2\" data-name=\"for business link\" href=\"#for-business\">\n                    Бизнесу\n                </a>\n                <a class=\"hover:text-[#0F172A]\" data-kid=\"1-3-1-2-3\" data-name=\"for influencers link\" href=\"#for-influencers\">\n                    Инфлюенсерам\n                </a>\n                <a class=\"hover:text-[#0F172A]\" data-kid=\"1-3-1-2-4\" data-name=\"catalog link\" href=\"#catalog\">\n                    Каталог\n                </a>\n                <a class=\"hover:text-[#0F172A]\" data-kid=\"1-3-1-2-5\" data-name=\"terms link\" href=\"#terms\">\n                    Условия\n                </a>\n                <a class=\"hover:text-[#0F172A]\" data-kid=\"1-3-1-2-6\" data-name=\"privacy link\" href=\"#privacy\">\n                    Конфиденциальность\n                </a>\n            </div>\n        </div>\n    </footer>\n    <div class=\"mx-auto mb-4 mt-4 flex w-[min(360px,calc(100vw-2rem))] items-center justify-between gap-4 rounded-[12px] border border-slate-700 bg-[#0F172A] px-4 py-3 text-white shadow-[0_16px_40px_rgba(15,23,42,.18)] md:mr-6\" data-kid=\"1-4\" data-name=\"cookie consent banner (inline)\">\n        <div class=\"flex items-center justify-between gap-4\" data-kid=\"1-4-1\" data-name=\"cookie banner inner container\">\n            <p class=\"text-[11px] leading-4 text-slate-300\" data-kid=\"1-4-1-1\" data-name=\"cookie explanation text\">\n                Мы используем необходимые cookie для входа и защиты сессии.\n                <a class=\"font-bold text-white underline underline-offset-2\" data-kid=\"1-4-1-1-1\" data-name=\"cookie policy link\" href=\"#cookies\">\n                    Подробнее\n                </a>\n            </p>\n            <button class=\"shrink-0 rounded-lg bg-white px-3.5 py-1.5 text-[11px] font-bold text-[#0F172A]\" data-kid=\"1-4-1-2\" data-name=\"accept cookies button\" type=\"button\">\n                Понятно\n            </button>\n        </div>\n    </div>\n</div>\n",
