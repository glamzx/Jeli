      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .motion-grid { background-image: linear-gradient(rgba(23,105,255,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(23,105,255,.07) 1px, transparent 1px); background-size: 48px 48px; }\n  .mesh-field { background-image: radial-gradient(circle at 18% 18%, rgba(114,228,255,.5), transparent 24%), radial-gradient(circle at 78% 22%, rgba(255,129,103,.28), transparent 23%), radial-gradient(circle at 70% 80%, rgba(255,232,120,.33), transparent 24%), linear-gradient(135deg, #f8fbff 0%, #eef5ff 52%, #fff8ec 100%); background-size: 140% 140%; background-position: 24% 20%; }\n  .ink-grid { background-image: linear-gradient(rgba(15,23,42,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(15,23,42,.08) 1px, transparent 1px); background-size: 28px 28px; }\n  .orbit-ring { border: 1px solid rgba(23,105,255,.28); border-radius: 999px; position: absolute; inset: 8%; transform: rotate(20deg); }\n  .orbit-ring.two { inset: 16%; border-color: rgba(255,129,103,.3); transform: rotate(-34deg) scaleX(.64); }\n  .orbit-ring.three { inset: 2%; border-color: rgba(255,205,68,.42); transform: rotate(62deg) scaleX(.48); }\n  .art-glow { box-shadow: 0 30px 90px rgba(23,105,255,.18), 20px 22px 0 rgba(255,232,120,.45); }\n  .float-dot { position: absolute; border-radius: 999px; pointer-events: none; will-change: transform; }\n  .hero-copy, .matcher-panel, .art-orbit, .reveal-section, .catalog-row { will-change: transform, opacity; }\n  .text-balance { text-wrap: balance; }\n</style>\n<div class=\"min-h-screen overflow-hidden bg-[#FBFCF8] font-['Plus_Jakarta_Sans'] text-[#0F172A] antialiased selection:bg-[#B9D4FF] selection:text-[#0F172A]\" data-kid=\"1\" data-name=\"page layout container\" id=\"light-motion-page\">\n    <header class=\"motion-header sticky top-0 z-40 border-b border-slate-200/70 bg-[#FBFCF8]/90 px-5 py-4 backdrop-blur-xl md:px-8\" data-kid=\"1-1\" data-name=\"header navigation container\">\n        <div class=\"mx-auto flex max-w-[1220px] items-center justify-between gap-6\" data-kid=\"1-1-1\">\n            <a class=\"shrink-0 font-['Outfit'] text-[27px] font-extrabold italic leading-none tracking-[-0.08em] text-[#0F172A]\" data-kid=\"1-1-1-1\" href=\"#top\">\n                Jeli\n                <span class=\"text-[#1769FF]\" data-kid=\"1-1-1-1-1\">\n                    .\n                </span>\n            </a>\n            <nav aria-label=\"Основная навигация\" class=\"hidden items-center gap-7 text-[12px] font-bold text-slate-500 lg:flex\" data-kid=\"1-1-1-2\">\n                <a class=\"hover:text-[#1769FF]\" data-kid=\"1-1-1-2-1\" href=\"#how-it-works\">\n                    Как работает\n                </a>\n                <a class=\"hover:text-[#1769FF]\" data-kid=\"1-1-1-2-2\" href=\"#business\">\n                    Бизнесу\n                </a>\n                <a class=\"hover:text-[#1769FF]\" data-kid=\"1-1-1-2-3\" href=\"#influencers\">\n                    Инфлюенсерам\n                </a>\n                <a class=\"hover:text-[#1769FF]\" data-kid=\"1-1-1-2-4\" href=\"#catalog\">\n                    Каталог\n                </a>\n                <a class=\"hover:text-[#1769FF]\" data-kid=\"1-1-1-2-5\" data-name=\"explore section link\" href=\"#motion-story\">\n                    Explore\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-3\">\n                <button aria-label=\"Переключить тему\" class=\"grid h-10 w-10 place-items-center rounded-[12px] border border-slate-200 bg-white text-[18px] text-slate-600 hover:border-[#1769FF] hover:text-[#1769FF]\" data-kid=\"1-1-1-3-1\" data-name=\"toggle theme button\" type=\"button\">\n                    <i class=\"ti ti-sun\" data-kid=\"1-1-1-3-1-1\" data-name=\"sun icon\" style=\"color:#1769FF;font-size:18px;line-height:1\">\n                    </i>\n                </button>\n                <a class=\"rounded-[12px] bg-[#1769FF] px-4 py-2.5 text-[12px] font-extrabold text-white hover:bg-[#0d55d7]\" data-kid=\"1-1-1-3-2\" href=\"/login\">\n                    Войти\n                </a>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" id=\"top\">\n        <section class=\"hero motion-grid mesh-field relative overflow-hidden px-5 pb-20 pt-14 md:px-8 md:pb-28 md:pt-20\" data-kid=\"1-2-1\" data-name=\"hero section\" id=\"hero\">\n            <div class=\"float-dot floating-orb-a right-[10%] top-[18%] h-5 w-5 bg-[#FF8167] shadow-[0_0_0_9px_rgba(255,129,103,.12)]\" data-kid=\"1-2-1-1\" data-name=\"floating decorative orb a\">\n            </div>\n            <div class=\"float-dot floating-orb-b left-[8%] top-[38%] h-3 w-3 bg-[#FFE878] shadow-[0_0_0_7px_rgba(255,232,120,.22)]\" data-kid=\"1-2-1-2\" data-name=\"floating decorative orb b\">\n            </div>\n            <div class=\"mx-auto grid max-w-[1220px] items-center gap-12 lg:grid-cols-[.88fr_1.12fr] lg:gap-16\" data-kid=\"1-2-1-3\">\n                <div class=\"hero-copy relative z-10\" data-kid=\"1-2-1-3-1\">\n                    <div class=\"mb-5 inline-flex items-center gap-2 rounded-[10px] border border-[#A9C8FF] bg-white/80 px-3 py-2 text-[11px] font-extrabold uppercase tracking-[0.14em] text-[#1769FF] shadow-sm\" data-kid=\"1-2-1-3-1-1\" data-name=\"hero badge container\">\n                        <span class=\"grid h-5 w-5 place-items-center rounded-[6px] bg-[#1769FF] text-white\" data-kid=\"1-2-1-3-1-1-1\" data-name=\"sparkles icon container\">\n                            <i class=\"ti ti-sparkles\" data-kid=\"1-2-1-3-1-1-1-1\" data-name=\"sparkles icon\" style=\"color:#FFFFFF;font-size:13px;line-height:1\">\n                            </i>\n                        </span>\n                        Jeli / Campaign engine\n                    </div>\n                    <h1 class=\"text-balance max-w-[650px] font-['Outfit'] text-[46px] font-extrabold leading-[.95] tracking-[-0.065em] text-[#0F172A] sm:text-[64px] lg:text-[74px]\" data-kid=\"1-2-1-3-1-2\">\n                        Запускайте кампании с людьми, которым уже доверяют\n                    </h1>\n                    <p class=\"mt-7 max-w-[520px] text-[16px] leading-7 text-slate-600\" data-kid=\"1-2-1-3-1-3\">\n                        AI-мэтчинг на базе реальных профилей, прозрачные условия и Escrow-защита — чтобы бизнес быстрее находил свою аудиторию.\n                    </p>\n                    <div class=\"mt-8 flex flex-wrap gap-3\" data-kid=\"1-2-1-3-1-4\">\n                        <a class=\"inline-flex items-center gap-2 rounded-[12px] bg-[#1769FF] px-5 py-3.5 text-[13px] font-extrabold text-white shadow-[7px_7px_0_#FFE878] hover:bg-[#0d55d7]\" data-kid=\"1-2-1-3-1-4-1\" href=\"#matcher\">\n                            Запустить кампанию\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-1-3-1-4-1-1\" style=\"color:#FFFFFF;font-size:15px;line-height:1\">\n                            </i>\n                        </a>\n                        <a class=\"inline-flex items-center gap-2 rounded-[12px] border border-[#0F172A] bg-white/70 px-5 py-3.5 text-[13px] font-extrabold text-[#0F172A] hover:bg-white\" data-kid=\"1-2-1-3-1-4-2\" href=\"#influencers\">\n                            Я инфлюенсер\n                            <i class=\"ti ti-arrow-down-right\" data-kid=\"1-2-1-3-1-4-2-1\" style=\"color:#1769FF;font-size:15px;line-height:1\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-[12px] font-bold text-slate-600\" data-kid=\"1-2-1-3-1-5\">\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-3-1-5-1\" data-name=\"escrow feature badge\">\n                            <i class=\"ti ti-shield-check\" data-kid=\"1-2-1-3-1-5-1-1\" data-name=\"shield check icon\" style=\"color:#1769FF;font-size:16px;line-height:1\">\n                            </i>\n                            Escrow до результата\n                        </span>\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-1-3-1-5-2\" data-name=\"profiles feature badge\">\n                            <i class=\"ti ti-user-check\" data-kid=\"1-2-1-3-1-5-2-1\" data-name=\"user check icon\" style=\"color:#FF6D54;font-size:16px;line-height:1\">\n                            </i>\n                            Реальные профили\n                        </span>\n                    </div>\n                </div>\n                <div class=\"relative min-h-[570px] lg:min-h-[620px]\" data-kid=\"1-2-1-3-2\">\n                    <div aria-hidden=\"true\" class=\"art-orbit pointer-events-none absolute -right-8 -top-16 z-0 h-[350px] w-[350px] sm:-right-10 sm:h-[430px] sm:w-[430px] lg:-right-28 lg:-top-24 lg:h-[550px] lg:w-[550px]\" data-kid=\"1-2-1-3-2-1\" data-name=\"hero art orbit\">\n                        <div class=\"orbit-ring\" data-kid=\"1-2-1-3-2-1-1\" data-name=\"first orbit ring\">\n                        </div>\n                        <div class=\"orbit-ring two\" data-kid=\"1-2-1-3-2-1-2\" data-name=\"second orbit ring\">\n                        </div>\n                        <div class=\"orbit-ring three\" data-kid=\"1-2-1-3-2-1-3\" data-name=\"third orbit ring\">\n                        </div>\n                        <div class=\"art-glow absolute inset-[15%] overflow-hidden rounded-full border-[10px] border-white/80 bg-[#72E4FF]\" data-kid=\"1-2-1-3-2-1-4\" data-name=\"glow art container\">\n                            <img alt=\"Colorful abstract 3D world art by Fachrizal Maulana on Unsplash\" class=\"h-full w-full object-cover mix-blend-multiply opacity-90\" data-kid=\"1-2-1-3-2-1-4-1\" data-name=\"abstract world image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1666846366866-35dd42f57b01?auto=format&w=900&q=80&fit=crop\"/>\n                        </div>\n                        <div class=\"floating-orb-c absolute left-[6%] top-[20%] grid h-14 w-14 place-items-center rounded-[18px] bg-[#FF8167] text-white shadow-[8px_8px_0_#0F172A]\" data-kid=\"1-2-1-3-2-1-5\" data-name=\"floating world icon orb\">\n                            <i class=\"ti ti-world\" data-kid=\"1-2-1-3-2-1-5-1\" data-name=\"world icon\" style=\"color:#FFFFFF;font-size:24px;line-height:1\">\n                            </i>\n                        </div>\n                        <div class=\"floating-orb-d absolute bottom-[8%] right-[7%] grid h-16 w-16 place-items-center rounded-full bg-[#FFE878] text-[#0F172A] shadow-[8px_8px_0_#1769FF]\" data-kid=\"1-2-1-3-2-1-6\" data-name=\"floating charts icon orb\">\n                            <i class=\"ti ti-chart-dots-3\" data-kid=\"1-2-1-3-2-1-6-1\" data-name=\"charts icon\" style=\"color:#0F172A;font-size:25px;line-height:1\">\n                            </i>\n                        </div>\n                        <div class=\"absolute right-[3%] top-[42%] rounded-[12px] border border-white bg-white/90 px-3 py-2 text-[10px] font-extrabold text-[#0F172A] shadow-lg\" data-kid=\"1-2-1-3-2-1-7\" data-name=\"reach stats badge\">\n                            + 84.2K reach\n                        </div>\n                    </div>\n                    <div class=\"matcher-panel relative z-10 mt-10 ml-auto max-w-[690px] rounded-[20px] border border-[#BFD4F5] bg-white p-5 shadow-[18px_20px_0_rgba(15,23,42,.08)] sm:p-7 lg:mt-20\" data-kid=\"1-2-1-3-2-2\">\n                        <div class=\"flex items-start justify-between gap-4 border-b border-slate-200 pb-5\" data-kid=\"1-2-1-3-2-2-1\">\n                            <div data-kid=\"1-2-1-3-2-2-1-1\">\n                             